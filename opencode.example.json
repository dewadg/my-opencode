{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "gitlab": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@zereight/mcp-gitlab"
        ],
        "environment": {
          "GITLAB_API_URL": "https://gitlab.com/api/v4",
          "GITLAB_READ_ONLY_MODE": "true",
          "GITLAB_PERSONAL_ACCESS_TOKEN": "{env:GITLAB_PAT}"
        }
      },
      "goland": {
        "type": "remote",
        "url": "http://127.0.0.1:64422/stream",
        "oauth": false
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "chrome-devtools-mcp@1.13.0",
          "--autoConnect"
        ]
      },
      "figma": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "figma-developer-mcp@v0.11.0",
          "--stdio"
        ],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        }
      },
      "mobile-device": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@srmorete/mobile-device-mcp@latest"
        ],
        "environment": {
          "MDMS_PORT_ANDROID": "18000",
          "MDMS_PORT_IOS": "19000"
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "glab variable *", "effect": "deny" },
    { "action": "shell", "resource": "docker context use *", "effect": "deny" },
    { "action": "shell", "resource": "docker context rm *", "effect": "deny" },
    { "action": "shell", "resource": "docker context create *", "effect": "deny" },
    { "action": "shell", "resource": "psql *", "effect": "deny" },
    { "action": "shell", "resource": "ssh *", "effect": "deny" }
  ]
}
